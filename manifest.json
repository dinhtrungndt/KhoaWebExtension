{
  "manifest_version": 3,
  "name": "Khóa Web · TSA Technology",
  "version": "1.0.0",
  "description": "Extension khóa trang web bằng mật khẩu. © 2026 TSA Technology.",
  "permissions": [
    "storage",
    "webNavigation",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "Khóa Web"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html"
}
